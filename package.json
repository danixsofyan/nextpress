{
  "name": "nextpress",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source WordPress alternative built on Next.js, with a REST API and an MCP server for AI agents",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed.mjs",
    "db:roles": "node scripts/db-roles.mjs",
    "test:coverage": "vitest run --coverage --coverage.include=src/lib/** --coverage.include=src/server/** --coverage.include=src/core/**"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@node-rs/argon2": "2.0.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@scalar/hono-api-reference": "^0.12.23",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@vercel/og": "^1.0.3",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "hono": "^4.13.19",
    "ioredis": "^6.0.0",
    "lottie-web": "5.13.0",
    "lucide-react": "^0.469.0",
    "marked": "^18.2.1",
    "next": "^15.3.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.18.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.20.0",
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "author": "Dani Sofyan (https://github.com/danixsofyan)",
  "homepage": "https://nextpress-app.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danixsofyan/nextpress.git"
  },
  "bugs": {
    "url": "https://github.com/danixsofyan/nextpress/issues"
  }
}
