# ── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. On Supabase use the pooler in Transaction mode (port 6543).
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Public URL of the site, no trailing slash. The admin panel lives at <this URL>/admin.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Fallback site name, used until a Site Title is saved in Admin → Settings → General
NEXT_PUBLIC_SITE_NAME=My Site

# Session signing secret, at least 32 characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Optional. Extra REST API and MCP key from the environment, at least 32 characters.
# Normally you create keys in Admin → Settings → API instead.
NEXTPRESS_API_KEY=

# Serve the NextPress developer documentation at /docs (the official demo site does this)
NEXTPRESS_DOCS=false

# Donations through SumoPod QRIS (the donate block stays hidden while this is empty).
# Use a SumoPod project of its own: one webhook URL serves one project.
SUMOPOD_API_KEY=
# Verifies /api/webhooks/sumopod. When several apps share one SumoPod project, its single webhook
# points at one app that relays NPD- orders here.
SUMOPOD_WEBHOOK_SECRET=
SUMOPOD_WEBHOOK_TOKEN=
# SUMOPOD_API_BASE_URL=https://api-pay.sumopod.com

# ── Optional: isolated admin domain ──────────────────────────────────────────
# Serve the admin panel only on its own domain, e.g. https://admin.yourdomain.com
# Point that domain at the same deployment. /admin on the public domain then returns 404.
ADMIN_URL=

# ── Optional: Redis ──────────────────────────────────────────────────────────
# Shared rate limiting for the API and login across instances. Without it, limits are per instance.
# Any Redis-compatible URL works (Upstash, Redis Cloud, self-hosted). Use rediss:// for TLS.
REDIS_URL=

# ── Media storage ────────────────────────────────────────────────────────────
# local = files in public/uploads (development only)
# s3    = any S3-compatible storage: Cloudflare R2, AWS S3, MinIO, Supabase Storage, Backblaze B2
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=s3
# Endpoint without bucket, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# "auto" for R2, the bucket region for AWS (e.g. ap-southeast-1)
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. Public base URL of the bucket, no trailing slash. Leave empty to keep the bucket private:
# files are then served from your own domain at /media/<file>, cached by the CDN.
S3_PUBLIC_URL=

# Maximum upload size in MB. Vercel functions accept request bodies up to 4.5 MB.
MAX_UPLOAD_SIZE_MB=4
